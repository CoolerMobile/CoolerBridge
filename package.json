{
  "name": "cooler-bridge",
  "type": "module",
  "version": "1.6.0",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "release": "gh workflow run release.yml",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "gen:keys": "bun dev/gen-cloud-keys.ts",
    "dev:pair": "bun dev/create-pair-assertion.ts",
    "dev:access": "bun dev/create-access-assertion.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "expo-server-sdk": "^8.0.0",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "dotenv": "^18.0.9",
    "prettier": "^3.9.10"
  }
}
