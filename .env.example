# runtime environment: "development" or "production"
# in development the CoolerCloud key is read from dev/keys; in production the
# bridge uses the baked-in CoolerCloud key and jwks discovery
NODE_ENV=production

# postgres credentials
# these create the database user in the postgres container and are used to build
# the bridge's DATABASE_URL in compose, so set a strong, unique password
# generate one with: openssl rand -base64 24
POSTGRES_DB=coolerbridge
POSTGRES_USER=coolerbridge
POSTGRES_PASSWORD=change-me

# postgres connection string
# used for local development and drizzle tooling (bun db:push, db:studio, ...)
# in compose this is derived from the POSTGRES_* values above, so this value is ignored there
DATABASE_URL=postgres://coolerbridge:change-me@localhost:5432/coolerbridge

# CoolerCloud trust is baked into the image and kept current through jwks
# discovery, so the two overrides below are for development and testing only

# advanced override for the baked-in CoolerCloud public key (Ed25519 SPKI, PEM)
# keep the literal newlines on a single line with \n
# CLOUD_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# advanced override for the jwks discovery endpoint used to pick up rotated keys
# set empty to disable discovery and trust only the key above
# CLOUD_JWKS_URL="https://cloud.getcooler.app/.well-known/jwks.json"

# secret pepper mixed into pairing code digests
# generate with: openssl rand -base64 32
PAIRING_PEPPER=change-me

# contingency ("moat") channel (all optional)
# the cloud status endpoint and the shared secret the bridge presents to it;
# leave both unset to disable the real-time check entirely
CLOUD_STATUS_URL="https://cloud.getcooler.app/api/bridges/status"
BRIDGE_RELAY_SECRET=change-me

# keep relaying when the cloud can't be reached ("true"); defaults to failing closed
# (the moat stays up) so a suspected breach is never relayed through on an outage
CONTINGENCY_FAIL_OPEN=false

# how long a confirmed contingency result is cached, in milliseconds (default 10000)
CONTINGENCY_TTL_MS=10000

# port the bridge listens on (optional, defaults to 3000)
PORT=3000
