# runtime environment: "development" or "production"
# in development the cloud key is read from dev/keys; in production the bridge
# uses the baked-in cloud keys and jwks discovery, with the overrides below
NODE_ENV=production

# postgres credentials
# these create the database user in the postgres container and are used to build
# the bridge's DATABASE_URL in compose, so set a strong, unique password
# generate one with: openssl rand -base64 24
POSTGRES_DB=coolerbridge
POSTGRES_USER=coolerbridge
POSTGRES_PASSWORD=change-me

# postgres connection string
# used for local development and drizzle tooling (bun db:push, db:studio, ...)
# in compose this is derived from the POSTGRES_* values above, so this value is ignored there
DATABASE_URL=postgres://coolerbridge:change-me@localhost:5432/coolerbridge

# cloud trust is baked into the image and kept current through jwks discovery,
# so the two settings below are optional and only needed for a self-hosted cloud

# override the cloud public key (Ed25519 SPKI, PEM) used to verify assertions
# replaces the baked-in keys; keep the literal newlines on a single line with \n
# CLOUD_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# override the jwks discovery endpoint used to pick up rotated cloud keys
# set empty to disable discovery and trust only the key(s) above
# CLOUD_JWKS_URL="https://cloud.getcooler.app/.well-known/jwks.json"

# secret pepper mixed into pairing code digests
# generate with: openssl rand -base64 32
PAIRING_PEPPER=change-me

# port the bridge listens on (optional, defaults to 3000)
PORT=3000
